# Supabase — copia este archivo a .env.local y pon tus valores.
# Los encuentras en el panel de Supabase: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# La clave `anon` es pública a propósito: puede ir en el navegador porque
# quien protege los datos es RLS, no el secreto de la clave. La clave
# `service_role` NO va en este proyecto: se salta RLS por completo.
